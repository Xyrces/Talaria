<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit tests; multi-target the same framework matrix the rest of the repo uses. -->
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Ship XML docs so cref references in test source resolve cleanly across the matrix. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Lets the test project see the internal scheduler seam inside the transport. -->
    <InternalsVisibleTo>Talaria.Transports.AzureServiceBus.Tests</InternalsVisibleTo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Messaging.ServiceBus" Version="7.20.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Talaria.Transports.AzureServiceBus\Talaria.Transports.AzureServiceBus.csproj" />
    <ProjectReference Include="..\..\src\Talaria.Transports.InMemory\Talaria.Transports.InMemory.csproj" />
    <ProjectReference Include="..\..\src\Talaria.Core\Talaria.Core.csproj" />
  </ItemGroup>

</Project>
