<Project>
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>

    <!-- Shared NuGet package metadata -->
    <RepositoryUrl>https://github.com/Xyrces/Talaria</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <Authors>Xyrces</Authors>
    <PackageProjectUrl>https://github.com/Xyrces/Talaria</PackageProjectUrl>
    <PackageTags>messaging;sagas;saga-orchestration;kafka;azure-service-bus;redis;outbox;idempotency;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="All" />
  </ItemGroup>
</Project>
