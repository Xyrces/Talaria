<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Talaria.Core\Talaria.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>In-memory transport implementation for the Talaria saga and messaging engine, ideal for tests and lightweight single-process deployments.</Description>
    <!-- Ship XML docs in the NuGet package; undocumented members are tolerated (CS1591 suppressed). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Talaria.InMemory.Tests" />
  </ItemGroup>

</Project>
